#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define LOWER 1
#define RAISE 2
#define MOUSE 3
#define BOT bootloader

/ {
    behaviors {
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&mkp LCLK>, <&bt BT_CLR>;
        };
    };

    behaviors {
        tdRMCLK: tap_dance_R_LMouse {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&mkp RCLK>, <&mkp MCLK>;
        };
    };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            bindings = <&kp &kp>;
        };
    };

    behaviors {
        LMouse_sc: behavior_LMouse_Scroll {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";     /* 单击优先 */
            tapping-term-ms = <200>;       /* 长按阈值 */
            bindings = <&none &mkp>;        /* hold=none, tap=Lmouse */
        };
    };

    behaviors {
        M_kp: behavior_mouse_keypress {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";     /* 单击优先 */
            tapping-term-ms = <200>;       /* 长按阈值 */
            bindings = <&mkp &kp>;        /* hold=mou key press, tap=key*/
        };
    };

    behaviors {
        BLE_encoder: BLE_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&bt BT_NXT>, <&bt BT_PRV>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "QWERTY";
            bindings = <
&mt ESC TAB  &kp Q                    &kp W     &kp E       &kp R     &kp T  &kp Y      &kp U      &kp I           &kp O         &kp P       &kp BSPC
&kp LCTRL    &kp A                    &kp S     &kp D       &kp F     &kp G  &mkp LCLK  &mkp LCLK  &kp H           &kp J         &kp K       &kp L     &kp SEMI                  &kp SQT
&kp LSHFT    &kp Z                    &kp X     &kp C       &kp V     &kp B  &kp PG_DN  &kp PG_UP  &msc SCRL_DOWN  &msc SCRL_UP  &kp N       &kp M     &kp COMMA                 &kp DOT            &kp FSLH  &kp RSHFT
&kp CAPS     &hm LS(LA(LC(LGUI))) F2  &kp LALT  &kp C_MUTE  &kp LGUI  &mo 1  &kp SPACE  &kp ENTER  &mo 2           &kp RGUI      &kp C_MUTE  &kp RALT  &hm LS(LA(LC(LGUI))) F12  &kp RC(RA(SPACE))
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp LEFT RIGHT>;
        };

        lower_layer {
            display-name = "LOWER";
            bindings = <
&kp ESC    &kp N1  &kp N2         &kp N3      &kp N4     &kp N5         &kp N6     &kp N7     &kp N8      &kp N9      &kp N0        &kp DEL
&kp LCTRL  &trans  &kp LG(GRAVE)  &kp GRAVE   &kp PLUS   &kp BACKSLASH  &mkp RCLK  &mkp RCLK  &kp LEFT    &kp DOWN    &kp UP        &kp RIGHT  &kp LC(LBKT)  &kp PAGE_UP
&kp LSHFT  &to 4   &trans         &kp TILDE   &kp MINUS  &kp PIPE       &trans     &trans     &bl BL_DEC  &bl BL_INC  &trans        &trans     &trans        &trans       &trans  &kp PAGE_DOWN
&kp CAPS   &trans  &BOT           &bt BT_CLR  &none      &mo 1          &none      &none      &none       &none       &out OUT_TOG  &BOT       &trans        &trans
            >;

            sensor-bindings = <&BLE_encoder &inc_dec_kp UP DOWN>;
        };

        raise_layer {
            display-name = "RAISE";
            bindings = <
&kp ESC    &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT  &kp CARET  &kp AMPS  &kp STAR  &kp LPAR   &kp RPAR  &none
&kp LCTRL  &none     &none   &none     &none     &none      &none      &none     &none     &kp EQUAL  &none     &kp LBKT   &kp RBKT  &none
&kp LSHFT  &none     &none   &none     &none     &none      &none      &none     &none     &none      &none     &kp UNDER  &none     &kp LBRC  &kp RBRC  &none
&kp CAPS   &none     &none   &none     &none     &none      &none      &none     &mo 2     &none      &none     &none      &none     &none
            >;

            sensor-bindings = <&BLE_encoder>;
        };

        MOUSE_layer {
            display-name = "MOUSE";
            bindings = <
&kp TAB    &kp Q     &kp W     &kp E  &kp R  &kp T      &kp Y           &M_kp MB3 U       &kp I     &kp O        &kp P       &kp BSPC
&kp CAPS   &kp A     &kp S     &kp D  &kp F  &kp G      &mkp LCLK       &mkp LCLK         &kp H     &M_kp MB1 J  &kp K       &kp L        &kp SEMI   &kp ENTER
&kp LSHFT  &kp Z     &kp X     &kp C  &kp V  &kp B      &msc SCRL_DOWN  &msc SCRL_UP      &none     &none        &kp N       &M_kp MB2 M  &kp COMMA  &kp DOT    &kp FSLH  &kp RSHFT
&kp LCTRL  &kp LGUI  &kp LALT  &none  &mo 2  &kp SPACE  &mkp MB1        &LMouse_sc 0 MB1  &tdRMCLK  &mo 2        &kp C_MUTE  &kp MINUS    &kp EQUAL  &kp GRAVE
            >;
        };

        RES_layer {
            display-name = "RESERVE";
            bindings = <
&kp TAB  &none     &kp UP    &none      &none  &none  &none  &kp N7     &kp N8     &kp N9  &none      &none
&none    &kp LEFT  &kp DOWN  &kp RIGHT  &none  &none  &none  &none      &kp PLUS   &kp N4  &kp N5     &kp N6  &kp STAR  &none
&none    &to 0     &none     &none      &none  &none  &none  &none      &none      &none   &kp MINUS  &kp N1  &kp N2    &kp N3  &kp SLASH  &none
&none    &none     &none     &none      &none  &none  &none  &kp ENTER  &kp EQUAL  &kp N0  &none      &none   &none     &none
            >;
        };
    };
};
